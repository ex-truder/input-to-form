{
  "$schema": "./pbr-model-animation.schema.json",
  "version": 1,
  "timeline": {
    "clip": "Scene",
    "loop": "ping-pong",
    "autoplay": true,
    "speed": 1
  },
  "viewer": {
    "environment": "environment/studio.hdr",
    "background": "transparent",
    "showEnvironment": false,
    "environmentIntensity": 1,
    "exposure": 1,
    "autoRotate": false
  },
  "materials": [
    {
      "target": "Material name from the GLB",
      "from": {
        "maps": {
          "baseColor": "textures/healthy/basecolor.webp",
          "normal": "textures/healthy/normal.webp",
          "orm": "textures/healthy/orm.webp",
          "emissive": "textures/healthy/emissive.webp"
        },
        "factors": {
          "baseColor": [1, 1, 1, 1],
          "roughness": 0.35,
          "metalness": 0,
          "normalScale": [1, 1],
          "emissive": [0, 0, 0],
          "emissiveIntensity": 0
        }
      },
      "to": {
        "maps": {
          "baseColor": "textures/advanced/basecolor.webp",
          "normal": "textures/advanced/normal.webp",
          "orm": "textures/advanced/orm.webp",
          "emissive": "textures/advanced/emissive.webp"
        },
        "factors": {
          "baseColor": [1, 1, 1, 1],
          "roughness": 0.7,
          "metalness": 0,
          "normalScale": [1, 1],
          "emissive": [0.1, 0.02, 0.01],
          "emissiveIntensity": 0.15
        }
      },
      "blend": {
        "easing": "smoothstep",
        "keyframes": [
          { "progress": 0, "value": 0 },
          { "progress": 0.2, "value": 0 },
          { "progress": 0.55, "value": 0.45 },
          { "progress": 1, "value": 1 }
        ]
      }
    },
    {
      "target": "Glass material name from the GLB",
      "side": "double",
      "shader": {
        "type": "glass-refraction",
        "parameters": {
          "color": [0.92, 0.98, 1],
          "roughness": 0.08,
          "transmission": 1,
          "thickness": 0.35,
          "ior": 1.5,
          "attenuationColor": [0.82, 0.95, 1],
          "attenuationDistance": 8,
          "dispersion": 0.02,
          "clearcoat": 1,
          "clearcoatRoughness": 0.05,
          "envMapIntensity": 1
        }
      },
      "from": {
        "maps": {
          "normal": "textures/glass/normal.webp",
          "roughness": "textures/glass/roughness.webp",
          "transmission": "textures/glass/transmission.webp",
          "thickness": "textures/glass/thickness.webp"
        }
      }
    }
  ]
}
